<body>

    <!-- Header -->
    <header>
        <h1>Food and Nutrition Blog</h1>
        <p>Healthy Eating, Healthy Living!</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a> |
        <a href="#nutrition">Nutrition</a> |
        <a href="#healthy-foods">Healthy Foods</a> |
        <a href="#tips">Healthy Eating Tips</a>
