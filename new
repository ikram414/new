    <!-- Main Content -->
    <main>

        <section id="home">
            <h2>Welcome to Our Blog</h2>
            <p>
                Welcome to our Food and Nutrition Blog!
                Here you will learn about healthy eating,
                balanced diets and the importance of good nutrition.
            </p>
        </section>

        <section id="nutrition">
            <h2>Importance of Nutrition</h2>

            <article>
                <h3>Why Is Good Nutrition Important?</h3>
                <p>
                    Good nutrition helps our bodies grow,
                    stay strong and fight diseases. Eating
                    a balanced diet gives us the energy
                    we need for everyday activities.
                </p>
            </article>

            <article id="healthy-foods">
                <h3>Five Healthy Foods to Eat</h3>
                <ul>
                    <li>Fruits</li>
                    <li>Vegetables</li>
                    <li>Whole grains</li>
                    <li>Fish and eggs</li>
                    <li>Nuts and beans</li>
                </ul>
            </article>
        </section>

        <section id="tips">
            <h2>Healthy Eating Tips</h2>

            <article>
                <h3>Tips for a Healthy Lifestyle</h3>
                <ol>
                    <li>Drink plenty of water.</li>
                    <li>Eat fruits and vegetables daily.</li>
                    <li>Avoid too much sugary food.</li>
                    <li>Exercise regularly.</li>
                    <li>Eat a balanced diet.</li>
                </ol>
            </article>
        </section>

        <!-- Aside Note -->
        <aside>
            <h3>Did You Know?</h3>
            <p>
                Drinking enough water helps regulate
                body temperature and keeps you hydrated.
            </p>
        </aside>

        <!-- Figures and Captions -->
        <section>
            <h2>Healthy Food Gallery</h2>

            <figure>
                <img src="https://placehold.co/400x250?text=Fresh+Fruits"
                     alt="Fresh fruits"
                     width="300">
                <figcaption>A variety of fresh and nutritious fruits.</figcaption>
            </figure>

            <figure>
                <img src="https://placehold.co/400x250?text=Healthy+Vegetables"
                     alt="Fresh vegetables"
                     width="300">
                <figcaption>Vegetables provide vitamins and minerals.</figcaption>
            </figure>
        </section>

        <!-- External Links -->
        <section>
